# ── Model selection ─────────────────────────────────────────────────────────
# Any LiteLLM model string works: https://docs.litellm.ai/docs/providers
# Examples:
#   openai/gpt-4o                 (needs OPENAI_API_KEY)
#   anthropic/claude-sonnet-5     (needs ANTHROPIC_API_KEY)
#   gemini/gemini-2.5-pro         (needs GEMINI_API_KEY)
#   ollama_chat/llama3            (local Ollama, no key)
#
# Add as many research agents as you like: MODEL_1, MODEL_2, MODEL_3, MODEL_4...
MODEL_1=openai/gpt-4o
MODEL_2=anthropic/claude-sonnet-5
MODEL_3=gemini/gemini-2.5-pro

# The judge is its own agent with its own model call.
JUDGE_MODEL=anthropic/claude-sonnet-5

# ── Per-model overrides (optional) ──────────────────────────────────────────
# For OpenAI-compatible gateways (Ollama cloud, OpenRouter, vLLM, LM Studio...)
# you can point any MODEL_N (or JUDGE_MODEL via JUDGE_MODEL_*) at a custom
# endpoint without touching code:
#   MODEL_1=openai/kimi-k2.5
#   MODEL_1_API_BASE=https://ollama.com/v1
#   MODEL_1_API_KEY=${OLLAMA_API_KEY}
# Note: ${VAR} expansion is not automatic — paste the actual key or leave
# MODEL_N_API_KEY unset to fall back to the provider's standard env var.

# ── Provider API keys (set the ones your chosen models need) ────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=

# ── Supervisor exercise ─────────────────────────────────────────────────────
# The supervisor picks which specialist acts next. Defaults to JUDGE_MODEL.
# Specialists use MODEL_1..N (researcher=MODEL_1, analyst=MODEL_2, writer=MODEL_3,
# wrapping around if you have fewer).
# SUPERVISOR_MODEL=anthropic/claude-sonnet-5
# Max supervisor decisions per run; the last one must produce the final answer.
MAX_SUPERVISOR_TURNS=8

# ── Mock mode ────────────────────────────────────────────────────────────────
# true = canned model replies + fake tool results: explore every exercise with
# no API keys, network or cost. Also works without a .env:
#   MOCK_MODELS=true ./start.sh
MOCK_MODELS=false

# ── Tuning ───────────────────────────────────────────────────────────────────
# Per-agent timeout in seconds. An agent that exceeds this is marked failed;
# the others continue and the judge synthesizes from whatever succeeded.
AGENT_TIMEOUT=120
# Max tokens for research answers and the judge synthesis.
# Note: Gemini 2.5 models spend "thinking" tokens from this budget — keep it
# generous or answers get silently truncated.
MAX_TOKENS=6000
# When tool use is enabled: max reason→act→observe cycles per agent before
# the loop withholds tools and forces a final answer.
MAX_TOOL_ITERATIONS=6
